<div class="d-flex flex-column gap-3">
  <div>
    <h1><%=@member.name%></h1>
  </div>
  <div>
    <%= form_for(@member,html: { class: "form d-flex flex-column gap-3 w-50", multipart: true, method: :put }) do |f|  %>
      <fieldset disabled class="d-flex flex-column gap-3">
        <div class="field">
          <%= f.label :phone_number, class: "form-label", for: "member_phone_number" %>
          <%= f.text_field :phone_number, autofocus: true, autocomplete: "tel", class: "form-control", id: "member_phone_number" %>
        </div>
        <div class="field">
          <%= f.label :position, class: "form-label d-block", for: "member_position" %>
          <%= f.select :position, options_for_select(Member.positions.keys, selected: f.object.position), { include_blank: 'Select position' }, class: "form-select", id: "member_position" %>
        </div>
        <div class="field">
          <%= f.label :date_of_birth, class: "form-label d-block", for: "member_date_of_birth" %>
          <%= f.date_field :date_of_birth,autocomplete: "bday", id: "member_date_of_birth", class: "form-control" %>
        </div>
        <div class="field">
          <%= f.label :infomation, class: "form-label", for: "member_information" %>
          <%= f.text_area :information, autofocus: true, autocomplete: "info", class: "form-control", id: "member_information" %>
        </div>
        <div class="field">
          <%= f.label :avatar, class: "form-label", for: "member_avatar" %>
          <% if @member.avatar.attached? %>
            <%= image_tag @member.avatar.variant(resize_to_limit: [150, 150]) %>
          <% else %>
            <p>No avatar uploaded</p>
          <% end %>
        </div>
      </fieldset>
    <% end %>
    <small class="d-flex justify-content-between">
      <%= link_to "Back", members_path %><br />
    </small>
  </div>
</div>