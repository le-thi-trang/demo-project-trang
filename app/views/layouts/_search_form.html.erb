<div class="d-flex justify-content-end">
  <%= form_with url: path, method: :get, local: true, class: "d-flex" do |f| %>
    <%= f.text_field :q, { value: params[:q], placeholder: "Search #{model_name}", class: "form-control me-2" } %>
    <%= f.submit "Search", class: "btn btn-primary" %>
  <% end %>
</div>