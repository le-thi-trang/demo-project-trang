<div class="modal fade" id="<%= modal_id%>" tabindex="-1" aria-labelledby="<%= modal_label_id%>" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="exampleModalLabel"><%= modal_title %></h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <%= modal_content.html_safe %>
      </div>
      <% unless hide_footer %>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <%= button_to modal_path, method: method, class: css_class do %>
            <%= modal_button %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>