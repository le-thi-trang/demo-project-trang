<div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
  <h5 class="mb-0">👥 Members in this Project</h5>
  <button class="btn btn-light btn-sm" data-bs-toggle="collapse" data-bs-target="#assignForm">
    ➕ Assign New
  </button>
  <div class="collapse mt-3" id="assignForm">
    <div class="card card-body border border-primary">
      <h5>Assign a New Member</h5>
      <%= form_with model: @assignment, url: project_assignments_path(@project), local: true, class: "form d-flex flex-column gap-3" do |f| %>
        <%= f.hidden_field :project_id, value: @project.id %>
        <div class="mb-3">
          <%= f.label :member_id, "Select Member", class: "form-label" %>
          <%= f.collection_select :member_id, Member.all, :id, :name, { prompt: "Choose member" }, class: "form-select" %>
        </div>
        <div class="mb-3">
          <%= f.label :role, "Role", class: "form-label" %>
          <%= f.select :role, Assignment.roles.keys.map { |r| [r.upcase, r] }, {}, class: "form-select" %>
        </div>
        <%= f.submit "Assign", class: "btn btn-success" %>
      <% end %>
    </div>
  </div>
</div>