<div class="container d-flex align-items-center justify-content-center">
  <div class="w-50 mx-auto border border-secondary rounded p-3 " style="background-color: #CFE2FF;">
    <h2 class="text-center mb-4">Forgot your password?</h2>
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "form-signup d-flex flex-column gap-3" }) do |f|  %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <div class="field">
        <%= f.label :email, class: "form-label", for: "user_email" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", id: "user_email" %>
      </div>
      <div class="actions my-3 d-flex justify-content-center ">
        <%= f.submit "Send me reset password instructions", class: "btn btn-primary w-100" %>
      </div>
    <% end %>
    <small class="d-flex justify-content-between">
      <%= render "devise/shared/links" %>
    </small>
  </div>
</div>
