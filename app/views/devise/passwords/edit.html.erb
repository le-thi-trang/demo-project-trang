<div class="container d-flex align-items-center justify-content-center">
  <div class="w-50 mx-auto border border-secondary rounded p-3 " style="background-color: #CFE2FF;">
    <h2 class="text-center mb-4">Change your password</h2>
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "form-signup d-flex flex-column gap-3" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>
      <div class="field">
        <%= f.label :password, "New password", for: "user_password", class: "form-label" %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", id: "user_password", class: "form-control" %>
      </div>
      <div class="field">
        <%= f.label :password_confirmation,"Confirm new password", for: "user_password_confirmation", class: "form-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", id: "user_password_confirmation", class: "form-control" %>
      </div>
      <div class="actions my-3 d-flex justify-content-center ">
        <%= f.submit "Change my password", class: "btn btn-primary w-100" %>
      </div>
    <% end %>
    <small class="d-flex justify-content-between">
      <%= render "devise/shared/links" %>
    </small>
  </div>
</div>
