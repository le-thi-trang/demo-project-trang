<div class="container d-flex align-items-center justify-content-center">
  <div class="w-50 mx-auto border border-secondary rounded p-3 " style="background-color: #CFE2FF;">
    <h2 class="text-center mb-4">Sign up</h2>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "form-signup d-flex flex-column gap-3" }) do |f|  %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <div class="field">
        <%= f.label :email, class: "form-label", for: "user_email" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", id: "user_email" %>
      </div>
      <div class="field">
        <%= f.label :name, class: "form-label", for: "user_name" %>
        <%= f.text_field :name, autofocus: true, autocomplete: "name", class: "form-control", id: "user_name" %>
      </div>
      <div class="field">
        <%= f.label :phone_number, class: "form-label", for: "user_phone_number" %>
        <%= f.text_field :phone_number, autofocus: true, autocomplete: "tel", class: "form-control", id: "user_phone_number" %>
      </div>
      <div class="field">
        <%= f.label :position, class: "form-label d-block", for: "user_position" %>
        <%= f.select :position, options_for_select(Member.positions.keys, selected: f.object.position), { include_blank: 'Select position' }, class: "form-select", id: "user_position" %>
      </div>
      <div class="field">
        <%= f.label :date_of_birth, class: "form-label d-block", for: "user_date_of_birth" %>
        <%= f.date_field :date_of_birth,autocomplete: "bday", id: "user_date_of_birth", class: "form-control" %>
      </div>
      <div class="d-flex flex-row justify-content-between gap-2">
        <div class="field">
          <%= f.label :password, for: "user_password", class: "form-label" %>
          <%= f.password_field :password, autocomplete: "new-password", id: "user_password", class: "form-control" %>
        </div>
        <div class="field">
          <%= f.label :password_confirmation, for: "user_password_confirmation", class: "form-label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", id: "user_password_confirmation", class: "form-control" %>
        </div>
      </div>
      <div class="actions my-3 d-flex justify-content-center ">
        <%= f.submit "Sign up", class: "btn btn-primary w-100" %>
      </div>
    <% end %>
    <small class="d-flex justify-content-between">
      <%= render "devise/shared/links" %>
    </small>
  </div>
</div>