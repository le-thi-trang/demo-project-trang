<div class="container d-flex align-items-center justify-content-center">
  <div class="w-25 mx-auto border border-secondary rounded p-3 " style="background-color: #CFE2FF;">
    <h2 class="text-center mb-4">Log in</h2>
    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "form-signin d-flex flex-column gap-3" }) do |f| %>
      <div class="field">
        <%= f.label :phone_number, class: "form-label", for: "user_phone_number" %>
        <%= f.text_field :phone_number, autofocus: true, autocomplete: "tel", class: "form-control", id: "user_phone_number" %>
      </div>
      <div class="field">
        <%= f.label :password, for: "user_password", class: "form-label" %>
        <%= f.password_field :password, autocomplete: "current-password", id: "user_password", class: "form-control" %>
      </div>
      <% if devise_mapping.rememberable? %>
        <div class="field form-check">
          <%= f.check_box :remember_me, class: "form-check-input", type: "checkbox" %>
          <%= f.label :remember_me, class: "form-check-label fs-15" %>
        </div>
      <% end %>
      <div class="actions my-3 d-flex justify-content-center">
        <%= f.submit "Log in", class: "btn btn-primary" %>
      </div>
    <% end %>
    <small class="d-flex justify-content-between">
      <%= render "devise/shared/links" %>
    </small>
  </div>
</div>