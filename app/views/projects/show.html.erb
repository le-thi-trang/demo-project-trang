<div class="d-flex flex-column gap-3">
  <div>
    <h1><%= @project.name %></h1>
  </div>
  <div>
    <%= form_for(@project,html: { class: "form d-flex flex-column gap-3 w-50", method: :get }) do |f|  %>
      <fieldset disabled class="d-flex flex-column gap-3">
        <div class="field">
          <%= f.label :infomation, class: "form-label", for: "project_information" %>
          <%= f.text_area :information, autofocus: true, autocomplete: "info", class: "form-control", id: "project_information" %>
        </div>
        <div class="field">
          <%= f.label :deadline, class: "form-label", for: "project_deadline" %>
          <%= f.datetime_local_field :deadline, value: f.object.deadline&.strftime("%Y-%m-%dT%H:%M"), autofocus: true, autocomplete: "deadline", class: "form-control", id: "project_deadline" %>
        </div>
        <div class="field">
          <%= f.label :project_type, class: "form-label d-block", for: "project_project_type" %>
          <%= f.select :project_type, options_for_select(Project.project_types.keys, selected: f.object.project_type), { include_blank: 'Select project type' }, class: "form-select", id: "project_project_type" %>
        </div>
        <div class="field">
          <%= f.label :status, class: "form-label d-block", for: "project_status" %>
          <%= f.select :status, options_for_select(Project.statuses.keys, selected: f.object.status), { include_blank: 'Select status' }, class: "form-select", id: "project_status" %>
        </div>
      </fieldset>
    <% end %>
    <div class="card mt-5 w-50">
      <%= render "projects/new_assignment", project: @project, feature_name: "➕ Assign New", feature_title: "Assign a New Member", button_name: "Assign" %>
      <div class="card-body">
        <% if @project.assignments.any? %>
          <table class="table table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>Name</th>
                <th>Role</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @assignments.each do |assignment| %>
                <tr>
                  <td><%= assignment.member.name %></td>
                  <td><span class="badge bg-secondary text-uppercase"><%= assignment.role %></span></td>
                  <td class="text-end">
                    <div class="d-flex flex-row justify-content-end">
                      <button type="button" class="btn btn-warning btn-sm me-2 btn-edit-assignment" data-bs-toggle="modal" data-bs-target="#editAssignmentModal<%= assignment.id %>">
                        <i class="bi bi-pencil-square"></i> Edit
                      </button>
                      <%= button_to project_assignment_path(assignment.project_id, assignment), method: :delete, data: { confirm: "Remove this member?" }, class: "btn btn-danger btn-sm" do %>
                        <i class="bi bi-trash3"></i> Remove
                      <% end %>
                    </div>
                  </td>
                </tr>
                <%= render "layouts/modal", 
                  modal_id: "editAssignmentModal#{assignment.id}", 
                  modal_label_id: "editAssignmentModalLabel#{assignment.id}", 
                  modal_title: "Update role of #{assignment.member.name}", 
                  modal_content: render("projects/modal_body", modal_path: project_assignment_path(@project, assignment), project: @project, button_name: "Update", assignment: assignment, disabled: true),
                  modal_path: project_assignment_path(assignment), 
                  modal_button: "Save", 
                  method: :patch, 
                  css_class: "btn btn-primary",
                  hide_footer: true
                %>
              <% end %>
            </tbody>
          </table>
          <div class="mt-3">
            <%= paginate @assignments %>
          </div>
        <% else %>
          <p class="text-muted">No members assigned yet. Add some! 👇</p>
        <% end %>
      </div>
    </div>
    <small class="d-flex justify-content-between mt-3">
      <%= link_to "Back", projects_path %><br />
    </small>
  </div>