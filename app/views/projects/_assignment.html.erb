<div class="card mt-5 w-50">
  <%= render "projects/new_assign", project: @project, feature_name: "➕ Assign New", feature_title: "Assign a New Member", button_name: "Assign" %>
  <div class="card-body">
    <% if @project.assignments.any? %>
      <table class="table table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th>Name</th>
            <th>Role</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @assignments.each do |assignment| %>
            <tr>
              <td><%= assignment.member.name %></td>
              <td><span class="badge bg-secondary text-uppercase"><%= assignment.role %></span></td>
              <td class="text-end">
                <div class="d-flex flex-row justify-content-end">
                  <button type="button" class="btn btn-warning btn-sm me-2 btn-edit-assignment" data-bs-toggle="modal" data-bs-target="#editAssignmentModal<%= assignment.id %>">
                    <i class="bi bi-pencil-square"></i> Edit
                  </button>
                  <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteAssignmentModal<%= assignment.id %>">
                    <i class="bi bi-trash3"></i> Remove
                  </button>
                </div>
              </td>
            </tr>
            <%= render "layouts/modal", 
                  modal_id: "editAssignmentModal#{assignment.id}", 
                  modal_label_id: "editAssignmentModalLabel#{assignment.id}", 
                  modal_title: "Update role of #{assignment.member.name}", 
                  modal_content: render("projects/modal_body", modal_path: project_assignment_path(@project, assignment), project: @project, button_name: "Update", assignment: assignment, disabled: true),
                  modal_button: "Save", 
                  method: :patch, 
                  css_class: "btn btn-primary",
                  hide_footer: true
                %>
            <%= render "layouts/modal", 
                  modal_id: "deleteAssignmentModal#{assignment.id}", 
                  modal_label_id: "deleteAssignmentModalLabel#{assignment.id}", 
                  modal_title: "Remove #{assignment.member.name}", 
                  modal_content: "Are you sure you want to remove #{assignment.member.name} from this project?",
                  modal_path: project_assignment_path(@project, assignment), 
                  modal_button: "Remove", 
                  method: :delete, 
                  css_class: "btn btn-danger",
                  hide_footer: false
                %>
          <% end %>
        </tbody>
      </table>
      <div class="mt-3">
        <%= paginate @assignments %>
      </div>
    <% else %>
      <p class="text-muted">No members assigned yet. Add some! 👇</p>
    <% end %>
  </div>